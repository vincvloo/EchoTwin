# Copy to .env and fill in what you have. Everything works without keys (rules + templates + browser voice).
HTTPS_PORT=8443
HTTP_PORT=8000
ROBOT_NAME=Pip

# AI (text intent fallback + scene description). NVIDIA build.nvidia.com free endpoints are OpenAI-compatible.
AI_PROVIDER=nvidia
AI_API_KEY=
AI_MODEL=meta/muse-glimmer-30b
AI_VISION_MODEL=meta/muse-glimmer-30b
AI_FALLBACK_MODELS=meta/llama-3.2-11b-vision-instruct

# ElevenLabs voice (optional; falls back to the browser's speech synthesis)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_flash_v2_5

# Kept demos per target before the robot will try on its own
MIN_DEMOS=2
SEED_DEMOS=4

# Feature flags: set to 0 to switch off instantly on stage
FEATURE_CAMERA=1
FEATURE_BRAIN=1
FEATURE_SHAKE=1

# Where the two Python environments live (used by launch.ps1 and the servers).
# Paths are relative to the repository, or absolute. Examples:
#   PERCEPTION_PY=.venv-perception/Scripts/python.exe   (Windows)    .venv-perception/bin/python   (Linux, macOS)
#   ROBOT_PY=.venv-robot/Scripts/python.exe
PERCEPTION_PY=
ROBOT_PY=
# Optional: a separate Python for the map steps if the GPU environment has no scipy/matplotlib
PERCEPTION_MAPS_PY=
# VGGT source folder (default: third_party/vggt, see README). Not needed if VGGT is pip-installed.
VGGT_PATH=
# The robot arm: builtin (default, works offline) | so_arm100 (after: python -m echotwin.robot.arm --download so_arm100)
# | a path to your own descriptor .json (docs/ARMS.md)
ARM=
# 3D scan from the phone: auto (3D when possible, else quick) | quick | 3d. Photos used; phone height in metres
# Words the detector looks for: objects365 (default) | coco | lvis | catalog | a text file, one name per line
DETECT_PROMPTS=
SCAN_MODE=auto
SCAN_FRAMES=12
SCAN_CAM_HEIGHT=0.45
